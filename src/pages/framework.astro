  <!-- ─── CTA ──────────────────────────────────────────────── -->
  <section class="bg-primary-600 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-4" data-aos="fade-up">
        Interested in discussing how the framework could apply to your utility?
      </h2>
      <p class="text-xl text-primary-100 mb-8 max-w-2xl mx-auto" data-aos="fade-up" data-aos-delay="100">
        Every utility is different. Let's start with understanding yours.
      </p>
      <div data-aos="fade-up" data-aos-delay="200">
        <Button
          href="/contact#consultation"
          variant="outline"
          size="lg"
          class="border-white text-white hover:bg-white hover:text-primary-600 font-medium"
        >
          Request Consultation
        </Button>
      </div>
    </div>
  </section>

</Layout>
