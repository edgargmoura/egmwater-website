        {
          label: 'Reservoir Operations',
          image: '/app_reserv.png',
          alt: 'Vista aérea de reservatório metálico',
          icon: null,
          position: 'center'
        },
        {
          label: 'Operational Monitoring',
          image: '/app_telemetri.png',
          alt: 'Sala de controle e telemetria',
          icon: null,
          position: 'center 40%'
        },
        {
          label: 'Water Loss & Efficiency',
          image: '/app_water_loss.png',
          alt: '',
          icon: null,
          position: 'center'
        }
      ].map((area, i) => (

        <article
          class="overflow-hidden rounded-xl bg-white border border-slate-200 shadow-sm hover:shadow-md transition-shadow duration-300"
          data-aos="fade-up"
          data-aos-delay={`${(i % 4) * 75}`}
        >

          <div
            class="w-full overflow-hidden bg-slate-100"
            style="height: var(--foto-altura);"
          >

            {area.image ? (
              <img
                src={area.image}
                alt={area.alt}
                width="1200"
                height="675"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover"
                style={`object-position: ${area.position}; transform: scale(var(--foto-zoom));`}
              />
            ) : (
              <div class="w-full h-full flex items-center justify-center bg-sky-50">
                <span
                  class="text-5xl"
                  aria-hidden="true"
                >
                  {area.icon}
                </span>
              </div>
            )}

          </div>

          <div class="min-h-[72px] px-4 py-4 flex items-center justify-center">
            <h3 class="text-[15px] font-semibold text-slate-800 text-center leading-snug">
              {area.label}
            </h3>
          </div>

        </article>

      ))}

    </div>
  </div>
</section>


