---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Button from '../components/Button.astro';
import WaveBotton from '../components/WaveBotton.astro';
import HeroNavigationCards from '../components/HeroNavigationCards.astro';
---

<Layout
  title="EGM Water Operational Framework"
  description="The EGM Water Operational Framework (EWOF) connects an operating event to an authorized response, a verified outcome, and a record the next shift can use."
>

  <!-- ─── Hero ─────────────────────────────────────────────── -->
  <section class="bg-gray-900 text-white py-20 relative overflow-hidden">
    <div class="absolute inset-0 z-0">
      <video 
        src="/egm_instit_framework.mp4" 
        alt="Modern water utility operations" 
        class="w-full h-full object-cover"
        autoplay
        playsinline
        muted
        preload="auto"
      ></video>
      <div class="absolute inset-0 bg-gradient-to-r from-primary-900/80 to-primary-800/60"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 py-20 md:py-28">
      <div class="max-w-3xl" data-aos="fade-up">
        <p class="text-primary-300 font-medium uppercase tracking-widest text-sm mb-4">Operational Decision Support</p>
        <h1 class="text-4xl md:text-5xl font-bold mb-6">EGM Water Operational Framework</h1>
        <p class="text-xl text-gray-300">
          A practical sequence that connects an operating event to an authorized response, a verified outcome, and a record the next shift can use.
        </p>
      </div>
    </div>
    <WaveBotton class="absolute bottom-0 left-0 right-0 text-white" />
  </section>

  <!-- <HeroNavigationCards /> -->

  <!-- ─── What is the Framework? ───────────────────────────── -->
  <section class="pt-2 pb-20">
    <div class="max-w-7.5xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Desktop: imagem única -->
      <div class="hidden sm:flex justify-center" data-aos="fade-up">
        <img
          src="/egm-water-framework-domains2.png"
          alt="EWOF cycle: Understand, Assess, Prioritize, Respond, Verify, and Learn, then Repeat. Flexible application: quick or urgent, structured or recurring, and progressive scaling."
          class="rounded-xl shadow-xl w-full h-auto"
        />
      </div>
      <!-- Mobile: duas imagens empilhadas -->
      <div class="sm:hidden flex flex-col gap-4" data-aos="fade-up">
        <img
          src="/framework-design-respon1.png"
          alt="EWOF cycle: Understand, Assess, Prioritize, Respond, Verify, and Learn, then Repeat."
          class="rounded-xl shadow-xl w-full h-auto"
        />
        <img
          src="/framework-design-respon2.png"
          alt="Flexible application of EWOF: quick or urgent, structured or recurring, and progressive scaling."
          class="rounded-xl shadow-xl w-full h-auto"
        />
      </div>
    </div>
  </section>

