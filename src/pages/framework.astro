            <h3 class="text-lg font-bold text-gray-900 mb-2">{item.title}</h3>
            <p class="text-gray-600 text-sm leading-relaxed">{item.body}</p>
          </a>
        ))}
      </div>

      <p class="max-w-3xl mx-auto mt-8 text-center text-sm text-gray-500" data-aos="fade-up">
        These resources are published by their respective organizations. EGM Water TechSol is not affiliated with or endorsed by the U.S. EPA.
