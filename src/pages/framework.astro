            rel="noopener noreferrer"
            class="block bg-white rounded-xl p-6 shadow-sm border-l-4 border-primary-500 hover:shadow-md transition-shadow duration-300"
            data-aos="fade-up"
            data-aos-delay={`${i * 75}`}
