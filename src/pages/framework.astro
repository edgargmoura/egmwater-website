---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Button from '../components/Button.astro';
import WaveBotton from '../components/WaveBotton.astro';

const evaluationDomains = [
  { label: 'Operational Impact', color: 'border-sky-500' },
  { label: 'Service Reliability', color: 'border-orange-500' },
  { label: 'Monitoring Capability', color: 'border-lime-600' },
  { label: 'Operational Efficiency', color: 'border-teal-600' },
  { label: 'Implementation Feasibility', color: 'border-slate-500' },
  { label: 'Long-Term Operational Sustainability', color: 'border-fuchsia-700' },
];
---

<Layout
  title="EGM Water Operational Framework"
  description="A practical, adaptable framework for water utility operational improvement — covering monitoring, efficiency, automation, and continuous improvement."
>

  <!-- ─── Hero ─────────────────────────────────────────────── -->
  <section class="bg-gray-900 text-white py-24 relative overflow-hidden">
    <div class="absolute inset-0 z-0">
      <video 
        src="/egm_instit_framework.mp4" 
        alt="Modern water utility operations" 
        class="w-full h-full object-cover"
        autoplay
        playsinline
        muted
        preload="auto"
      ></video>
      <div class="absolute inset-0 bg-gradient-to-r from-primary-900/80 to-primary-800/60"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 py-24 md:py-36">
      <div class="max-w-3xl" data-aos="fade-up">
        <p class="text-primary-300 font-medium uppercase tracking-widest text-sm mb-4">Operational Decision Support</p>
        <h1 class="text-4xl md:text-5xl font-bold mb-6">EGM Water Operational Framework</h1>
        <p class="text-xl text-gray-300">
          A Practical Framework for Water Utility Operational Improvement
        </p>
      </div>
    </div>
    <WaveBotton class="absolute bottom-0 left-0 right-0 text-white" />
  </section>

  <!-- ─── What is the Framework? ───────────────────────────── -->
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-12 items-center">

        <div data-aos="fade-right">
          <SectionHeading
            title="What is the EGM Water Operational Framework?"
            subtitle=""
          />
          <p class="text-gray-600 mb-6 leading-relaxed">
            The EGM Water Operational Framework is a structured, practical approach developed to help water utilities identify operational gaps, prioritize improvements, and implement effective changes — informed by practical water utility operating experience and structured operational analysis.
          </p>
          <p class="text-gray-600 mb-6 leading-relaxed">
            It bridges the gap between operational knowledge and structured decision support, providing a clear path from assessment to sustainable improvement without prescribing a single "one-size-fits-all" solution.
          </p>
          <p class="text-gray-600 leading-relaxed">
            Whether the challenge is water loss, inadequate monitoring, operational inefficiency, or readiness for automation, the framework provides the structure to address it systematically.
          </p>
        </div>

        <div class="relative" data-aos="fade-left">
          <div class="sm:hidden rounded-xl bg-white p-5 shadow-xl border border-gray-100">
            <p class="text-center text-lg font-bold text-gray-900 mb-4">Six Evaluation Domains</p>
            <div class="grid grid-cols-2 gap-3">
              {evaluationDomains.map((domain) => (
                <div class={`rounded-lg border-l-4 bg-gray-50 p-3 ${domain.color}`}>
                  <span class="text-sm font-semibold leading-snug text-gray-800">{domain.label}</span>
                </div>
              ))}
            </div>
          </div>
          <img
            src="/egm-water-framework-domains.svg"
            alt="Six EWOF evaluation domains: Operational Impact, Service Reliability, Monitoring Capability, Operational Efficiency, Implementation Feasibility, and Long-Term Operational Sustainability"
            class="hidden sm:block rounded-xl shadow-xl w-full"
          />
          <p class="mt-4 text-center text-sm text-gray-500">
            Six evaluation domains support structured comparison throughout the operational improvement cycle.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- ─── Core Principle ───────────────────────────────────── -->
  <section class="py-16 bg-primary-600">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-primary-200 font-medium uppercase tracking-widest text-sm mb-4" data-aos="fade-up">Core Principle</p>
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-10" data-aos="fade-up" data-aos-delay="100">
        The Continuous Improvement Cycle
      </h2>

      <!-- Cycle steps -->
      <div class="flex flex-wrap justify-center items-center gap-2 md:gap-0" data-aos="fade-up" data-aos-delay="200">
        {[
          { label: 'Understand', icon: '🔍' },
          { label: 'Assess',     icon: '📊' },
          { label: 'Prioritize', icon: '🎯' },
          { label: 'Improve',    icon: '🔧' },
          { label: 'Verify',     icon: '✅' },
          { label: 'Learn',      icon: '📘' },
        ].map((step, i, arr) => (
          <div class="flex items-center">
            <div class="flex flex-col items-center bg-white/10 backdrop-blur rounded-xl px-5 py-4 min-w-[90px]">
              <span class="text-2xl mb-1">{step.icon}</span>
              <span class="text-white font-semibold text-sm">{step.label}</span>
            </div>
            {i < arr.length - 1 && (
              <svg class="hidden md:block h-5 w-5 text-primary-300 mx-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            )}
          </div>
        ))}
      </div>

      <p class="text-primary-100 mt-8 max-w-2xl mx-auto" data-aos="fade-up" data-aos-delay="300">
        The framework moves through six operational stages. After Learn, Repeat returns the process to Understand as conditions, evidence, and priorities evolve.
      </p>
      <div class="mt-4 inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-2 text-sm font-semibold text-white" data-aos="fade-up" data-aos-delay="350">
        <span aria-hidden="true">🔄</span>
        <span>Repeat: return to Understand for the next cycle</span>
      </div>
    </div>
  </section>

  <!-- ─── Six Operational Stages ───────────────────────────── -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        title="Six Operational Stages"
        subtitle="The stages provide a structured sequence for organizing evidence, decisions, actions, verification, and learning. Repeat returns the framework to the first stage for the next cycle."
        centered={true}
      />

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mt-4">

        <!-- Stage 1 -->
        <div class="bg-white rounded-xl p-6 shadow-sm border-t-4 border-primary-500 hover:shadow-md transition-shadow duration-300" data-aos="fade-up">
          <div class="flex items-center mb-4">
            <span class="w-9 h-9 rounded-full bg-primary-100 text-primary-700 font-bold text-sm flex items-center justify-center mr-3 flex-shrink-0">01</span>
            <h3 class="text-lg font-bold text-gray-900">Understand</h3>
          </div>
          <p class="text-sm font-semibold text-primary-700 mb-2">What's happening, and what needs attention?</p>
          <p class="text-gray-600 text-sm leading-relaxed">
            Define the condition, possible impact, operational context, authority, constraints, and immediate information gaps.
          </p>
        </div>

        <!-- Stage 2 -->
        <div class="bg-white rounded-xl p-6 shadow-sm border-t-4 border-secondary-500 hover:shadow-md transition-shadow duration-300" data-aos="fade-up" data-aos-delay="100">
          <div class="flex items-center mb-4">
            <span class="w-9 h-9 rounded-full bg-secondary-100 text-secondary-700 font-bold text-sm flex items-center justify-center mr-3 flex-shrink-0">02</span>
            <h3 class="text-lg font-bold text-gray-900">Assess</h3>
          </div>
          <p class="text-sm font-semibold text-secondary-700 mb-2">What do we know, and what still needs checking?</p>
          <p class="text-gray-600 text-sm leading-relaxed">
            Organize relevant evidence, information-quality notes, uncertainties, and the expected operating condition when later comparison requires one.
          </p>
        </div>

        <!-- Stage 3 -->
        <div class="bg-white rounded-xl p-6 shadow-sm border-t-4 border-accent-500 hover:shadow-md transition-shadow duration-300" data-aos="fade-up" data-aos-delay="200">
          <div class="flex items-center mb-4">
            <span class="w-9 h-9 rounded-full bg-accent-100 text-accent-700 font-bold text-sm flex items-center justify-center mr-3 flex-shrink-0">03</span>
            <h3 class="text-lg font-bold text-gray-900">Prioritize</h3>
          </div>
          <p class="text-sm font-semibold text-accent-700 mb-2">What matters most right now?</p>
          <p class="text-gray-600 text-sm leading-relaxed">
            State the priority and next decision based on local consequences, urgency, uncertainty, and authorized capacity.
          </p>
        </div>

        <!-- Stage 4 -->
        <div class="bg-white rounded-xl p-6 shadow-sm border-t-4 border-primary-400 hover:shadow-md transition-shadow duration-300" data-aos="fade-up" data-aos-delay="50">
          <div class="flex items-center mb-4">
            <span class="w-9 h-9 rounded-full bg-primary-50 text-primary-600 font-bold text-sm flex items-center justify-center mr-3 flex-shrink-0">04</span>
            <h3 class="text-lg font-bold text-gray-900">Improve</h3>
          </div>
          <p class="text-sm font-semibold text-primary-700 mb-2">What's the next safe, authorized action?</p>
          <p class="text-gray-600 text-sm leading-relaxed">
            Execute the selected action within approved procedures, assigned authority, safeguards, and operating constraints.
          </p>
        </div>

        <!-- Stage 5 -->
        <div class="bg-white rounded-xl p-6 shadow-sm border-t-4 border-secondary-400 hover:shadow-md transition-shadow duration-300" data-aos="fade-up" data-aos-delay="150">
          <div class="flex items-center mb-4">
            <span class="w-9 h-9 rounded-full bg-secondary-50 text-secondary-600 font-bold text-sm flex items-center justify-center mr-3 flex-shrink-0">05</span>
            <h3 class="text-lg font-bold text-gray-900">Verify</h3>
          </div>
          <p class="text-sm font-semibold text-secondary-700 mb-2">Did it actually work?</p>
          <p class="text-gray-600 text-sm leading-relaxed">
            Use observed evidence to confirm whether the intended operating condition was achieved, including unexpected effects and the next disposition.
          </p>
        </div>

        <!-- Stage 6 -->
        <div class="bg-white rounded-xl p-6 shadow-sm border-t-4 border-accent-400 hover:shadow-md transition-shadow duration-300" data-aos="fade-up" data-aos-delay="250">
          <div class="flex items-center mb-4">
            <span class="w-9 h-9 rounded-full bg-accent-50 text-accent-600 font-bold text-sm flex items-center justify-center mr-3 flex-shrink-0">06</span>
            <h3 class="text-lg font-bold text-gray-900">Learn</h3>
          </div>
          
          <p class="text-gray-600 text-sm leading-relaxed">
            Retain a concise asset-linked event record, unresolved issue, lesson, or trigger for structured review.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- ─── Areas of Application ─────────────────────────────── -->
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        title="Areas of Application"
        subtitle="The framework can support evaluation across selected areas of water utility operations, adapted to local conditions, available evidence, and utility authority."
        centered={true}
      />

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-4">
        {[
          { label: 'Water Treatment Operations',        icon: '💧' },
          { label: 'Pumping Stations',                  icon: '⚙️' },
          { label: 'Reservoir Operations',              icon: '🏞️' },
          { label: 'Distribution Systems',              icon: '🗺️' },
          { label: 'Operational Monitoring',            icon: '📡' },
          { label: 'Water Loss & Efficiency',           icon: '📉' },
          { label: 'Water Scarcity / Operational Stress', icon: '⚠️' },
          { label: 'Automation-Readiness Assessment',   icon: '🔌' },
        ].map((area, i) => (
          <div
            class="bg-white rounded-xl p-5 shadow-sm border border-gray-100 hover:border-primary-300 hover:shadow-md transition-all duration-300 flex flex-col items-center text-center"
            data-aos="fade-up"
            data-aos-delay={`${(i % 4) * 75}`}
          >
            <span class="text-3xl mb-3">{area.icon}</span>
            <span class="text-gray-800 font-medium text-sm leading-snug">{area.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── Technology's Role ─────────────────────────────────── -->
  <!-- <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto" data-aos="fade-up">
        <SectionHeading
          title="Technology's Role"
          subtitle="A tool, not a purpose."
          centered={true}
        />
        <div class="bg-white rounded-xl p-8 shadow-sm border-l-4 border-primary-500">
          <p class="text-gray-700 leading-relaxed mb-4">
            Technology — sensors, SCADA, automation, data analytics — plays an important role in modern water utility operations. But within the EGM Water Operational Framework, technology is always positioned as a means to an operational end, not as the goal itself.
          </p>
          <p class="text-gray-700 leading-relaxed mb-4">
            Utilities with mature operational processes and clear monitoring objectives are better positioned to use technology effectively. Acquiring technology without operational clarity may limit its value — regardless of the sophistication of the tools.
          </p>
          <p class="text-gray-700 leading-relaxed font-medium text-primary-700">
            The framework is designed to place operational understanding and clear priorities before any technology recommendation.
          </p>
        </div>
      </div>
    </div>
  </section> -->

