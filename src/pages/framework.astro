  <!-- ─── Guidance We Build On ─────────────────────────────── -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        title="Guidance We Build On"
        subtitle="EWOF is designed to work alongside established U.S. water-sector guidance. These public resources are a useful starting point for any utility."
        centered={true}
      />

      <div class="max-w-4xl mx-auto mt-4 space-y-4">
        {[
          {
            title: 'Effective Utility Management: A Primer for Water Sector Utilities',
            source: 'U.S. EPA and water-sector partners',
            body: 'Management attributes, performance measures, and continuous improvement. EWOF applies the same thinking at the level of a single operating decision.',
            url: 'https://www.epa.gov/sustainable-water-infrastructure/effective-water-utility-management-practices',
          },
          {
            title: 'Incident Action Checklists for Water Utilities',
            source: 'U.S. EPA',
            body: 'Preparedness, response, and recovery steps by incident type. EWOF follows the utility\'s own procedures and adds a consistent record of what was decided and verified.',
            url: 'https://www.epa.gov/waterutilityresponse/incident-action-checklists-water-utilities',
          },
          {
            title: 'Successfully Protecting Your Investment in Drinking Water Infrastructure',
            source: 'U.S. EPA',
            body: 'Asset-management practices from communities and local experts. Asset-linked event records from EWOF can inform the next asset review.',
            url: 'https://www.epa.gov/sites/default/files/2017-07/documents/asset_management_fact_sheets_20170602.pdf',
          },
        ].map((item, i) => (
