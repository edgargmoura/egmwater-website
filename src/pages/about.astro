---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Button from '../components/Button.astro';
import WaveBotton from '../components/WaveBotton.astro';
---

<Layout 
  title="About Us | EGM Water TechSol"
  description="Learn about EGM Water TechSol, its operational approach, mission, and the professional experience behind its work with water utilities."
>
  <!-- Hero Section -->
  <section class="bg-gray-900 text-white py-24 relative overflow-hidden">
    <div class="absolute inset-0 z-0">
      <video 
        src="/operador_movie.mp4" 
        alt="Engineers working" 
        class="w-full h-full object-cover"
        style="object-position: center 35%;"
        autoplay
        muted
        playsinline
        preload="auto"
      ></video>
      <div class="absolute inset-0 bg-gradient-to-r from-primary-800/70 to-primary-800/70"></div>
    </div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 py-24 md:py-36">
      <div class="max-w-3xl" data-aos="fade-up">
        <h1 class="text-4xl md:text-5xl font-bold mb-6">About Us</h1>
        <p class="text-xl text-gray-300">
          Practical experience applied to water utility operations, with a focus on operational efficiency, monitoring, automation, and continuous improvement.
        </p>
      </div>
    </div>
    <WaveBotton class="absolute bottom-0 left-0 right-0 text-white" />
  </section>

  <!-- Our Story Section -->
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div data-aos="fade-right">
          <SectionHeading 
            title="Our Story" 
            subtitle="From a dream of transformation to the reality of positive impact"
          />
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Who We Are</h2>
          <p class="text-gray-600 mb-6">
            EGM Water TechSol is a water utility operations consulting initiative founded by Edgar Galindo de Moura, a chemistry professional with postgraduate education in Environmental Engineering and Basic Sanitation and extensive practical experience in water treatment and distribution operations.
            The company was created to apply practical operational knowledge to the challenges faced by water utilities, particularly in operational monitoring, automation, water-loss management, system efficiency, and continuous improvement.
          </p>
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Our Approach</h2>
          
          <p class="text-gray-600 mb-6">
              We believe operational improvement begins with understanding how a system actually operates.
              Rather than starting with a predefined technology, EGM Water evaluates operational conditions, available information, existing infrastructure, and improvement priorities before considering appropriate solutions.
          </p>
          
          <p class="text-gray-600 mb-6">
            Our goal is to support water utilities with practical, responsible, and adaptable operational strategies that strengthen efficiency, reliability, and long-term resilience.
          </p>
        </div>
        
        <div class="relative" data-aos="fade-left">
          <img 
            src="/medidores.png" 
            alt="Water meters" 
            class="rounded-lg shadow-xl w-full"
          />
          <div class="absolute -bottom-6 -right-6 bg-white p-4 rounded-lg shadow-lg hidden md:block">
            <img 
              src="/torneira.png" 
              alt="Faucet detail" 
              class="rounded w-32 h-32 object-cover"
            />
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Mission and Values -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading 
        title="Mission and Values" 
        subtitle="The principles that guide our work and commitment"
        centered={true}
      />
      
      <div class="grid md:grid-cols-3 gap-8 mt-12">
        <!-- Mission -->
        <div class="bg-white rounded-xl p-8 shadow-sm border-l-4 border-primary-500 hover:shadow-md transition-shadow duration-300" data-aos="fade-up">
          <div class="flex items-center mb-6">
            <div class="w-12 h-12 rounded-lg bg-primary-100 flex items-center justify-center mr-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-primary-600">Mission</h3>
          </div>
          <p class="text-gray-700 leading-relaxed">
            To support water utilities in improving operational efficiency, reliability, monitoring, and decision-making through practical, structured, and adaptable operational strategies.
          </p>
        </div>
        
        <!-- Vision -->
        <div class="bg-white rounded-xl p-8 shadow-sm border-l-4 border-secondary-500 hover:shadow-md transition-shadow duration-300" data-aos="fade-up" data-aos-delay="100">
          <div class="flex items-center mb-6">
            <div class="w-12 h-12 rounded-lg bg-secondary-100 flex items-center justify-center mr-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-secondary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-secondary-600">Vision</h3>
          </div>
          <p class="text-gray-700 leading-relaxed">
            To become a trusted operational improvement partner for water utilities seeking practical approaches to monitoring, automation, efficiency, and continuous improvement.
          </p>
        </div>
        
        <!-- Values -->
        <div class="bg-white rounded-xl p-8 shadow-sm border-l-4 border-red-500 hover:shadow-md transition-shadow duration-300" data-aos="fade-up" data-aos-delay="200">
          <div class="flex items-center mb-6">
            <div class="w-12 h-12 rounded-lg bg-accent-100 flex items-center justify-center mr-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-accent-600" fill="none" viewBox="0 0 24 24" stroke="red">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-red-600">Values</h3>
          </div>
          <ul class="text-gray-700 space-y-3">
            <li class="flex items-start">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-accent-500 mr-3 mt-0.5 flex-shrink-0" viewBox="0 0 20 20" fill="red">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              <span>Technical Excellence</span>
            </li>
            <li class="flex items-start">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-accent-500 mr-3 mt-0.5 flex-shrink-0" viewBox="0 0 20 20" fill="red">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              <span>Continuous Improvement</span>
            </li>
            <li class="flex items-start">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-accent-500 mr-3 mt-0.5 flex-shrink-0" viewBox="0 0 20 20" fill="red">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              <span>Social and Environmental Responsibility</span>
            </li>
            <li class="flex items-start">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-accent-500 mr-3 mt-0.5 flex-shrink-0" viewBox="0 0 20 20" fill="red">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              <span>Integrity and Ethics</span>
            </li>
            <li class="flex items-start">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-accent-500 mr-3 mt-0.5 flex-shrink-0" viewBox="0 0 20 20" fill="red">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              <span>Commitment to Results</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Team Section - Founder -->
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading 
        title="Our Leadership" 
        subtitle="Meet the founder behind EGM Water TechSol"
        centered={true}
      />
      
      <div class="mt-12 grid md:grid-cols-2 gap-12 items-center" data-aos="fade-up">
        <div>
          <img 
            src="https://images.pexels.com/photos/5668859/pexels-photo-5668859.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=1" 
            alt="Edgar Moura, Founder and CEO" 
            class="rounded-lg shadow-md w-full"
          />
        </div>
        
        <div>
          <h3 class="text-2xl font-bold text-gray-900 mb-2">Edgar Moura</h3>
          <p class="text-primary-600 font-medium mb-6">Founder and CEO</p>
          
          <p class="text-gray-600 mb-4">
            Edgar is a chemistry professional with postgraduate education in Environmental Engineering and Basic Sanitation and more than 16 years of professional experience in the water and sanitation sector.
          </p>
          
          <p class="text-gray-600 mb-4">
            His professional background includes practical experience in water treatment and distribution operations, operational monitoring, automation, instrumentation, reservoir-related operations, and operational improvement within a large-scale water utility environment.
          </p>
          
          <p class="text-gray-600 mb-6">
            This experience provides the practical foundation for the operational approach being developed through EGM Water TechSol.
          </p>
          
          <div class="flex space-x-4 mb-6">
            <a 
              href="https://www.linkedin.com/in/edgar-moura/" 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-md font-medium text-sm transition-colors duration-200"
            >
              <svg class="h-5 w-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
              LinkedIn
            </a>
            
            <a 
              href="https://www.editoraunisv.com.br/post/biodegradacao-do-polihidroxibutirato-em-ambientes-diversos-desafios-para-uma-producao-sustentavel?utm_source=so&cid=17bd406f-02b6-4008-93a1-1020e4347e99&utm_content=78f3d4c5-efa2-418a-972f-e49f12ac86c2&postId=9a1a7a90-09a3-4f8f-ad66-65faf531bd59&utm_campaign=76ed2595-fdb0-482c-bb4b-4e9788093b8c&utm_medium=mail" 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center px-4 py-2 bg-gray-600 hover:bg-gray-700 text-white rounded-md font-medium text-sm transition-colors duration-200"
            >
              <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
              Scientific Publication
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Call to Action -->
  <section class="bg-primary-600 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-6" data-aos="fade-up">
        Let's work together for a more sustainable future
      </h2>
      <p class="text-xl text-primary-100 mb-8 max-w-3xl mx-auto" data-aos="fade-up" data-aos-delay="100">
        Learn how EGM Water TechSol can support your utility in identifying operational priorities and exploring practical opportunities for monitoring, efficiency, automation, and continuous improvement.
      </p>
      <div data-aos="fade-up" data-aos-delay="200">
        <Button 
          href="/contact" 
          variant="outline"
          size="lg"
          class="border-white text-white hover:bg-white hover:text-primary-600 font-medium"
        >
          Contact Us
        </Button>
      </div>
    </div>
  </section>
</Layout>