---
import SectionHeading from './SectionHeading.astro';

const articles = [
  {
    title: "Online Water Quality Monitoring Resources",
    excerpt: "Guidance and technical resources on real-time monitoring in source waters and distribution systems, including operational control and event detection.",
    image: "blog_iot.png",
    category: "Monitoring",
    source: "U.S. EPA",
    url: "https://www.epa.gov/waterresilience/online-water-quality-monitoring-resources"
  },
  {
    title: "Effective Water Utility Management Practices",
    excerpt: "Tools and guidance for assessing utility operations, setting priorities, measuring performance, and supporting continuous improvement.",
    image: "/knowledge_center_image_2.png",
    category: "Utility Management",
    source: "U.S. EPA",
    url: "https://www.epa.gov/sustainable-water-infrastructure/effective-water-utility-management-practices"
  },
  {
    title: "Water Efficiency and Conservation Resources for Drinking Water Systems",
    excerpt: "Resources on water audits, distribution-system losses, conservation, and practical efficiency measures for public water systems.",
    image: "/knowledge_center_image_3.png",
    category: "Water Efficiency",
    source: "U.S. EPA",
    url: "https://www.epa.gov/dwcapacity/water-efficiency-and-conservation-resources-small-drinking-water-systems"
  }
];
---

<section class="py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading 
      title="Knowledge Center" 
      subtitle="Selected external reading on water utility operations, monitoring, treatment, efficiency, and continuous improvement."
      centered={true}
    />
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-12">
      {articles.map((article, index) => (
        <a href={article.url} target="_blank" rel="noopener noreferrer" class="group" data-aos="fade-up" data-aos-delay={index * 100}>
          <div class="bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-300 h-full flex flex-col border border-gray-100">
            <div class="relative h-48">
              <img 
                src={article.image} 
                alt={article.title} 
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              <span class="absolute top-3 left-3 bg-primary-500 text-white text-xs px-2 py-1 rounded">
                {article.category}
              </span>
            </div>
            
            <div class="p-6 flex-grow">
              <p class="text-sm font-medium text-primary-700 mb-2">External reading · {article.source}</p>
              <h3 class="text-xl font-semibold mb-3 text-gray-900 group-hover:text-primary-600 transition-colors">
                {article.title}
              </h3>
              <p class="text-gray-600">
                {article.excerpt}
              </p>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
