---
import SectionHeading from './SectionHeading.astro';
import ServiceCard from './ServiceCard.astro';

const services = [
  {
    title: 'Operational Assessment & Optimization',
    description: 'Structured assessment of water utility operations to identify operational limitations, monitoring gaps, recurring issues, and practical improvement opportunities.',
    image: '/projetos_infraestrutura-4.png',
    url: '/services#infrastructure',
    highlight: 'slate'
  },
  {
    title: 'Automation & Operational Monitoring',
    description: 'Evaluation and improvement of monitoring and automation strategies to support operational visibility, timely response, and more consistent decision-making.',
    image: '/automação_monitoramento.png',
    url: '/services#automation',
    highlight: 'gray'
  },
  {
    title: 'Water Loss & Operational Efficiency',
    description: 'Operational assessment focused on identifying opportunities to improve system efficiency, monitoring practices, pressure-related operations, and water-loss management.',
    image: '/tecnologias_verdes.png',
    url: '/services#technologies',
    highlight: 'zinc'
  },
  {
    title: ' Operational Consulting & Knowledge Transfer',
    description: 'Practical consulting, documentation, and training support designed to strengthen operational procedures, staff knowledge, and continuous improvement practices.',
    image: 'https://images.pexels.com/photos/1181533/pexels-photo-1181533.jpeg?auto=compress&cs=tinysrgb&w=200&h=150&dpr=1',
    url: '/education',
    highlight: 'stone'
  },
];
---

<section class="py-20 bg-gray-50" id="services">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading 
      title="Our Services" 
      subtitle="Practical operational services designed to help water utilities improve visibility, efficiency, reliability, and decision-making."
      centered={true}
    />
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-12">
      {services.map((service, index) => (
        <ServiceCard 
          title={service.title}
          description={service.description}
          image={service.image}
          url={service.url}
          highlight={service.highlight}
        />
      ))}
    </div>
  </div>
</section>