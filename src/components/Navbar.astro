---
const navItems = [
  { name: 'Home', url: '/' },
  { name: 'About Us', url: '/about' },
  { name: 'Framework', url: '/framework' },
  { name: 'Contact', url: '/contact' },
];
---

<header class="egm-site-header sticky top-0 z-50 bg-white/95 backdrop-blur-sm shadow-sm">
  <!-- The exact Lone Star / Texas art from the approved mockup. Decorative only. -->
  <!-- <img src="/egm-lone-star-blue-header.png" alt="" aria-hidden="true" class="egm-texas-header-art" width="258" height="88" /> -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-20">
      <div class="flex-shrink-0 flex items-center">
        <a href="/" class="flex min-w-0 items-center gap-2 sm:gap-3">
          <img
            src="/logo_egmwatertechsol.png"
            alt="EGM Water TechSol Logo"
            class="h-24 w-auto flex-shrink-0 sm:h-28 md:h-32"
          />
          <span class="egm-brand-text hidden text-primary-600 font-heading font-bold text-2xl whitespace-nowrap 2xl:inline">EGM Water TechSol</span>
        </a>
      </div>

      <!-- Desktop Menu -->
      <nav class="egm-desktop-nav hidden lg:flex items-center space-x-4" aria-label="Main navigation">
        {navItems.map(item => (
          <a
            href={item.url}
            class="px-3 py-2 text-gray-700 hover:text-primary-600 font-medium text-sm transition-colors duration-200"
          >
            {item.name}
          </a>
        ))}
        <a
          href="/contact#consultation"
          class="ml-4 px-4 py-2 bg-primary-500 hover:bg-primary-600 text-white rounded-md font-medium text-sm transition-colors duration-200"
        >
          Request Consultation
        </a>
      </nav>

      <!-- Mobile menu button -->
      <div class="lg:hidden flex flex-shrink-0 items-center">
        <button
          id="mobile-menu-button"
          type="button"
          class="rounded-md p-2 text-gray-700 hover:text-primary-600 focus:outline-none focus:ring-2 focus:ring-primary-500"
          aria-label="Open navigation menu"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden lg:hidden bg-white border-t border-gray-200">
    <div class="px-2 pt-2 pb-3 space-y-1">
      {navItems.map(item => (
        <a
          href={item.url}
          class="block px-3 py-2 text-gray-700 hover:text-primary-600 font-medium text-base"
        >
          {item.name}
        </a>
      ))}
      <a
        href="/contact#consultation"
        class="block mt-4 px-3 py-2 bg-primary-500 hover:bg-primary-600 text-white rounded-md font-medium text-base"
      >
        Request Consultation
      </a>
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');

  if (mobileMenuButton && mobileMenu) {
    mobileMenuButton.addEventListener('click', () => {
      const isOpen = mobileMenuButton.getAttribute('aria-expanded') === 'true';
      mobileMenu.classList.toggle('hidden');
      mobileMenuButton.setAttribute('aria-expanded', String(!isOpen));
      mobileMenuButton.setAttribute('aria-label', isOpen ? 'Open navigation menu' : 'Close navigation menu');
    });
  }
</script>


